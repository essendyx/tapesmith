<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for Tapesmith (project slug "tapesmith", artifact configuration
  slug "initial"). Copy this file into the SignPath project; the release workflow
  (.github/workflows/release.yml) references it by slug.

  Input: the GitHub Actions artifact "Tapesmith-unsigned-<version>" uploaded by the release
  workflow. upload-artifact stores it as a ZIP archive, so the root element is <zip-file>. The
  archive contains the PyInstaller folder "Tapesmith/" (Tapesmith.exe plus "_internal/").

  Signed: Tapesmith.exe, the only binary built from this repository. Its version resource is
  written by tools/build_portable.py (ProductName "Tapesmith", ProductVersion = __version__); the
  attributes below enforce these values, as required by the SignPath Foundation.

  Not signed: everything in "_internal/". These are upstream binaries (Python, Qt, Pillow,
  cryptography, pywin32, winrt, zxing-cpp and others). Many already carry their publisher's
  signature (Python Software Foundation, The Qt Company, Microsoft); the SignPath Foundation
  conditions allow shipping unsigned upstream OSS binaries inside a signed package but not signing
  them with the project certificate.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Tapesmith/Tapesmith.exe" product-name="Tapesmith" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
