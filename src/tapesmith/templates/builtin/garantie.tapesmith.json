{
  "schema_version": 2,
  "name": "garantie",
  "description": "Garantie-Etikett: Gerät und errechnetes Ende der Garantie aus Kaufdatum + Laufzeit.",
  "category": "Büro",
  "tags": ["buero", "garantie", "kauf"],
  "fields": [
    {"id": "geraet", "label": "Gerät", "type": "input", "required": true, "max_len": 20},
    {"id": "kaufdatum", "label": "Kaufdatum (TT.MM.JJJJ)", "type": "input", "required": true},
    {"id": "dauer", "label": "Laufzeit (Monate)", "type": "input", "default": "24", "choices": ["12", "24", "36"]},
    {"id": "ende", "label": "Garantie bis", "type": "date", "base_field": "kaufdatum", "offset_months_field": "dauer"}
  ],
  "layout": {"lines": ["{geraet}", "Garantie bis {ende}"]},
  "sample": {"geraet": "Kaffeemaschine", "kaufdatum": "31.01.2026", "dauer": "24"},
  "translations": {
    "en": {
      "title": "warranty",
      "description": "Warranty label: device and calculated end of the warranty from purchase date + term.",
      "category": "Office",
      "tags": ["office", "warranty", "purchase"],
      "fields": {
        "geraet": {"label": "Device"},
        "kaufdatum": {"label": "Purchase date (DD.MM.YYYY)"},
        "dauer": {"label": "Term (months)"},
        "ende": {"label": "Warranty until"}
      },
      "lines": ["{geraet}", "Warranty until {ende}"],
      "sample": {"geraet": "Coffee machine"}
    }
  }
}
