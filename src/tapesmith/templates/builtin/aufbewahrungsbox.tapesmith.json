{
  "schema_version": 2,
  "name": "aufbewahrungsbox",
  "title": "Aufbewahrungsbox",
  "description": "Aufbewahrungsbox mit QR (Nummer + Ort), Nummer fett und Ort darunter.",
  "category": "Haushalt",
  "tags": ["haushalt", "box", "lager"],
  "fields": [
    {"id": "nummer", "label": "Nummer", "type": "input", "required": true, "max_len": 10},
    {"id": "ort", "label": "Ort", "type": "input", "required": true, "max_len": 20},
    {"id": "inhalt", "label": "Inhalt (nur intern)", "type": "input", "max_len": 20}
  ],
  "document": {
    "objects": [
      {"kind": "qr", "id": "qr1", "x": 8, "y": 0, "w": 88, "h": 88, "data": "{nummer} {ort}", "error": "m"},
      {"kind": "text", "id": "text1", "x": 104, "y": 2, "w": 300, "h": 42, "text": "{nummer}", "font": "sans-bold", "size": null},
      {"kind": "text", "id": "text2", "x": 104, "y": 46, "w": 400, "h": 38, "text": "{ort}", "size": null}
    ]
  },
  "sample": {"nummer": "BOX-07", "ort": "Keller Regal 2"},
  "translations": {
    "en": {
      "title": "Storage box",
      "description": "Storage box with QR code (number + location), number in bold with the location below.",
      "category": "Household",
      "tags": ["household", "box", "storage"],
      "fields": {
        "nummer": {"label": "Number"},
        "ort": {"label": "Location"},
        "inhalt": {"label": "Contents (internal only)"}
      },
      "sample": {"ort": "Basement shelf 2"}
    }
  }
}
