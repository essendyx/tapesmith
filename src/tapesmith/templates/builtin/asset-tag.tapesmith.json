{
  "schema_version": 2,
  "name": "asset-tag",
  "description": "Anlagen-Kennzeichnung mit QR (Standard-Link HTTP://L.LAN/<Nummer>), Nummer fett und Bezeichnung.",
  "category": "Homelab",
  "tags": ["homelab", "asset", "qr"],
  "fields": [
    {"id": "nummer", "label": "Nummer", "type": "input", "required": true, "max_len": 10},
    {"id": "bezeichnung", "label": "Bezeichnung", "type": "input", "max_len": 20}
  ],
  "document": {
    "objects": [
      {"kind": "qr", "id": "qr1", "x": 8, "y": 0, "w": 88, "h": 88, "data": "HTTP://L.LAN/{nummer|upper}", "error": "m"},
      {"kind": "text", "id": "text1", "x": 112, "y": 2, "w": 300, "h": 42, "text": "{nummer}", "font": "sans-bold", "size": null},
      {"kind": "text", "id": "text2", "x": 112, "y": 46, "w": 400, "h": 38, "text": "{bezeichnung}", "size": null}
    ]
  },
  "sample": {"nummer": "HL-0042", "bezeichnung": "Patchkabel Cat6 3m"},
  "translations": {
    "en": {
      "title": "asset-tag",
      "description": "Asset tag with QR code (default link HTTP://L.LAN/<number>), number in bold and description.",
      "category": "Homelab",
      "tags": ["homelab", "asset", "qr"],
      "fields": {
        "nummer": {"label": "Number"},
        "bezeichnung": {"label": "Description"}
      },
      "sample": {"bezeichnung": "Patch cable Cat6 3 m"}
    }
  }
}
